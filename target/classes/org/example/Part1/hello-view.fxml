<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Pane prefHeight="550.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Part1.HelloController">
   <children>
      <Label layoutX="14.0" layoutY="14.0" text="Application form" />
      <Label layoutX="14.0" layoutY="47.0" text="Name:" />
      <TextField fx:id="NameField" layoutX="103.0" layoutY="43.0" prefHeight="25.0" prefWidth="188.0" />
      <Label fx:id="EmailError" layoutX="322.0" layoutY="80.0" prefHeight="17.0" prefWidth="160.0" />
      <Label layoutX="14.0" layoutY="80.0" text="Email:" />
      <TextField fx:id="EmailField" layoutX="103.0" layoutY="76.0" onAction="#onEmail" prefHeight="25.0" prefWidth="188.0" promptText="example@gmail.com" />
      <Label layoutX="14.0" layoutY="114.0" text="Phone number:" />
      <TextField fx:id="PhoneField" layoutX="103.0" layoutY="110.0" onAction="#onPhone" prefHeight="25.0" prefWidth="188.0" promptText="+380458719532" />
      <CheckBox fx:id="TermsButton" layoutX="33.0" layoutY="452.0" mnemonicParsing="false" prefHeight="17.0" prefWidth="129.0" text="I agree with terms" />
      <Button layoutX="31.0" layoutY="480.0" mnemonicParsing="false" onAction="#OnSubmit" text="Submit" />
      <Label layoutX="17.0" layoutY="148.0" text="Document that  confirms your English" />
      <RadioButton layoutX="15.0" layoutY="175.0" mnemonicParsing="false" text="NMT">
         <toggleGroup>
            <ToggleGroup fx:id="english" />
         </toggleGroup>
      </RadioButton>
      <RadioButton layoutX="82.0" layoutY="175.0" mnemonicParsing="false" text="IEELTS" toggleGroup="$english" />
      <RadioButton layoutX="160.0" layoutY="175.0" mnemonicParsing="false" text="Duolingo" toggleGroup="$english" />
      <Button layoutX="13.0" layoutY="231.0" mnemonicParsing="false" onAction="#onDownloadEnglish" text="Download" />
      <Label layoutX="17.0" layoutY="203.0" prefHeight="17.0" prefWidth="144.0" text="Download your certificate" />
      <Label fx:id="DownloadError" layoutX="117.0" layoutY="235.0" prefHeight="17.0" prefWidth="357.0" />
      <Label layoutX="17.0" layoutY="323.0" prefHeight="17.0" prefWidth="246.0" text="You can write any comments here" />
      <TextArea fx:id="CommentArea" layoutX="14.0" layoutY="340.0" prefHeight="102.0" prefWidth="478.0" />
      <Label layoutX="17.0" layoutY="263.0" text="Choose Bachelor's program" />
      <ChoiceBox fx:id="ChoiceProgram" layoutX="16.0" layoutY="288.0" prefWidth="150.0" />
      <Label fx:id="SubmitText" layoutX="96.0" layoutY="484.0" prefHeight="17.0" prefWidth="150.0" />
      <Label fx:id="GmailError" layoutX="308.0" layoutY="80.0" prefHeight="17.0" prefWidth="129.0" />
      <Label fx:id="PhoneError" layoutX="308.0" layoutY="114.0" prefHeight="17.0" prefWidth="160.0" />
   </children>
</Pane>
